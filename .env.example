# AgentCrashTest Environment Configuration
# Copy this file to .env.local

# Gemini API Key (Server-side only, optional)
# If not provided, deterministic mock/demo mode will be used
GEMINI_API_KEY=

# Application Port (default: 3000)
PORT=3000

# SQLite Database Path (defaults to ./data/agentcrashtest.db)
DATABASE_PATH=./data/agentcrashtest.db
