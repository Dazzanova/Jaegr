# =============================================================================
# Jaegr — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# Every variable below is optional. With no API keys, Jaegr runs in
# Deterministic Demo Mode and all security-evaluation features still work.
#
# Do not commit `.env`, and never prefix secrets with NEXT_PUBLIC_ — that would
# expose them to the browser bundle.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Solana network
# ─────────────────────────────────────────────────────────────────────────────

# Target cluster. Jaegr rejects transaction preparation, simulation, signing
# checks, submission, and confirmation unless this is `devnet`.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Server-side Devnet RPC endpoint. This URL is never sent to the browser.
# The public endpoint is rate-limited; use Helius, QuickNode, Triton, or your
# own validator for reliable simulation and confirmation polling.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional browser-visible RPC URL, used only for client-side read calls such
# as the network-status indicator. If unset, the client falls back to the
# server RPC URL configuration.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Timeout for every server-side RPC call, including simulation and
# confirmation polling. Default: 8000 ms.
SOLANA_RPC_TIMEOUT_MS=8000


# ─────────────────────────────────────────────────────────────────────────────
# Live LLM providers (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Groq — recommended live provider. Uses Groq's OpenAI-compatible API with
# JSON-mode output. Free-tier limits are per-minute, and typical latency is
# 1–3 seconds. Keys stay server-side only.
# Create a key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional Groq model override. Default: openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — optional secondary provider. Uses the official Google GenAI
# SDK and the Interactions API. The free tier is limited to 20 requests/day,
# so it is best treated as a comparison or fallback provider.
# Create a key: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# Optional Gemini model override. Default: gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash


# ─────────────────────────────────────────────────────────────────────────────
# Persistence
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database path, relative to the project root. Default: data/jaegr.db.
# The database stores test runs, execution evidence, and audit history.
# DATABASE_PATH=data/jaegr.db


# ─────────────────────────────────────────────────────────────────────────────
# Test-only overrides — not needed in normal use
# ─────────────────────────────────────────────────────────────────────────────

# Shorten confirmation polling so integration tests run quickly.
# Defaults: 30 attempts with a 1000 ms interval.
# SOLANA_CONFIRMATION_ATTEMPTS=30
# SOLANA_CONFIRMATION_INTERVAL_MS=1000

# Enable the opt-in live Devnet suite. `pnpm test:devnet` sets this itself.
# RUN_DEVNET_TESTS=1


# ─────────────────────────────────────────────────────────────────────────────
# Wallet notes — no secrets belong here
# ─────────────────────────────────────────────────────────────────────────────

# Jaegr never asks for, stores, logs, or transmits private keys or seed
# phrases. Wallet connection and signing happen entirely in the browser through
# the Wallet Standard.
#
# 1. Install a Wallet Standard wallet (Phantom, Solflare, or Backpack).
# 2. Switch the wallet to Devnet.
# 3. Fund it with Devnet SOL:
#      solana airdrop 1 <YOUR_WALLET_ADDRESS> --url devnet
#    or use https://faucet.solana.com
