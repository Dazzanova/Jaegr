# ============================================================
# Jaegr — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# ── Solana Network ───────────────────────────────────────────
# Target cluster: devnet | testnet | mainnet-beta | localnet
# Jaegr only supports Devnet for transaction simulation and execution.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Primary RPC endpoint (server-side only — never exposed to browser)
# Default: https://api.devnet.solana.com (Solana public RPC)
# Replace with your Helius/QuickNode/Triton endpoint for better reliability.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional: public RPC URL exposed to the browser (for client-side reads only)
# If not set, the app falls back to SOLANA_DEVNET_RPC_URL.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: server-side RPC timeout in milliseconds (default: 8000)
# Applies to every RPC call, including simulation and confirmation polling.
SOLANA_RPC_TIMEOUT_MS=8000

# ── Test-only overrides (never needed in normal use) ─────────
# Shorten confirmation polling so integration tests run quickly.
# Defaults: 30 attempts, 1000 ms interval.
# SOLANA_CONFIRMATION_ATTEMPTS=30
# SOLANA_CONFIRMATION_INTERVAL_MS=1000
#
# Enable the opt-in live Devnet suite. `pnpm test:devnet` sets this itself.
# RUN_DEVNET_TESTS=1

# ── Google Gemini API ────────────────────────────────────────
# Required only if you want live Gemini 3.8 Flash agent evaluation.
# Without this, the app runs in Deterministic Demo Mode (all features work).
# Get your key: https://ai.google.dev/gemini-api/docs/api-key
# KEEP THIS SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite database file. Relative to the project root.
# Default: data/jaegr.db
# DATABASE_PATH=data/jaegr.db

# ── Wallet Configuration ──────────────────────────────────────
# No wallet private keys or seed phrases are ever stored here.
# Wallet connection is handled entirely in the browser via Wallet Standard.
# Install Phantom or Solflare and configure it for Devnet before connecting.
#
# How to get Devnet SOL:
#   1. Set your wallet to Devnet in wallet settings
#   2. Run: solana airdrop 1 <YOUR_WALLET_ADDRESS> --url devnet
#   3. Or use: https://faucet.solana.com
